{
  "private": true,
  "devDependencies": {
    "@wordpress/env": "^11.11.0",
    "@wordpress/scripts": "^33.0.0",
    "npm-run-all2": "^9.0.2"
  },
  "scripts": {
    "env": "wp-env",
    "start": "wp-env start --xdebug=debug,coverage",
    "stop": "wp-env stop",
    "build": "npm-run-all2 build:*",
    "build:php": "composer install --no-dev --optimize-autoloader",
    "build:js": "wp-scripts build --source-path=js"
  }
}
